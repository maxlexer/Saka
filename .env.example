NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase: Project Settings > API. The service role key is server only, never prefix it with NEXT_PUBLIC.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Admin, one password for staff. The session secret must be at least 32 random characters.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# khqr.dev developer portal
KHQR_TOKEN=
KHQR_WEBHOOK_SECRET=

# Telegram: BotFather token and the admin group chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
# Sent back by Telegram in x-telegram-bot-api-secret-token. Pass the same value to setWebhook as secret_token.
TELEGRAM_WEBHOOK_SECRET=

# Vercel sends this as a Bearer token to /api/cron/daily. It also salts stored IP hashes.
CRON_SECRET=

# Test only. Leave unset: an empty value would override the real API host.
# KHQR_API_BASE=
# TELEGRAM_API_BASE=
